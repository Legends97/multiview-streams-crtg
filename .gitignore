# ---------------------------------------------------------------------------
# Zugangsdaten
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local

# ---------------------------------------------------------------------------
# Erzeugte Ordner — duerfen NICHT ins Repository
#
# Git unter Windows speichert kein Ausfuehrbar-Bit. Mitgelieferte
# node_modules sind auf dem Linux-Server von Vercel deshalb nicht
# ausfuehrbar: der Build bricht mit "Permission denied" und Exit-Code 126 ab.
# Vercel installiert die Pakete selbst aus package-lock.json, die im
# Repository liegt.
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Lokales
# ---------------------------------------------------------------------------
.vercel/
npm-debug.log*
.vscode/
.idea/
.DS_Store
Thumbs.db
