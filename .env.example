# ---------------------------------------------------------------------------
# Pflicht — ohne diese beiden Werte startet die Anwendung nicht
# ---------------------------------------------------------------------------

# Öffentliche Basis-URL, mit Protokoll, ohne Slash am Ende.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Erlaubte Parent-Hosts für Twitch-Embeds: nur Hostnamen, kommasepariert.
# Keine Wildcards, kein Protokoll, kein Port. localhost immer mit aufnehmen.
# Fehlt die Produktionsdomain, bleiben Player und Chat schwarz.
NEXT_PUBLIC_TWITCH_PARENTS=localhost

# ---------------------------------------------------------------------------
# Optional — Supabase (Dashboard > Project Settings > API)
#
# Ohne diese Werte laufen Streams, Twitch-Chat, Renn- und Event-Seite
# vollständig. Es fehlen dann: Anmeldung, Community-Chat und gespeicherte
# Player-Layouts. Einrichtung: docs/05-supabase-setup.md
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Umgeht RLS vollständig. Nur serverseitig, niemals mit NEXT_PUBLIC_ Prefix.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Optional — Twitch Helix API für Live-Status und Zuschauerzahlen
# https://dev.twitch.tv/console/apps
# ---------------------------------------------------------------------------
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
